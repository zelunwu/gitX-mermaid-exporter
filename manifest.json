{
  "manifest_version": 3,
  "name": "gitX Mermaid Exporter",
  "version": "0.3.3",
  "description": "Export Mermaid diagrams exactly as rendered by GitHub Viewscreen.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "downloads"
  ],
  "host_permissions": [
    "https://github.com/*",
    "https://viewscreen.githubusercontent.com/*"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "action": {
    "default_title": "Choose Mermaid diagrams to export",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://github.com/*"],
      "js": ["lib/filename.js", "lib/page.js", "content/github.js"],
      "css": ["content/github.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://viewscreen.githubusercontent.com/*"],
      "js": [
        "lib/filename.js",
        "lib/dom.js",
        "lib/svg.js",
        "lib/png.js",
        "content/viewscreen.js"
      ],
      "css": ["content/viewscreen.css"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
